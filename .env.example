# Hanbova Application Environment Configuration
# Options: development | test | pilot | production
HANBOVA_ENV=development
HANBOVA_API_HOST=127.0.0.1
HANBOVA_API_PORT=8080

# Database Configuration (PostgreSQL)
# Required in pilot and production (must be a valid postgres:// URI)
DATABASE_URL=postgres://hanbova:change-me@127.0.0.1:5434/hanbova
POSTGRES_USER=hanbova
POSTGRES_PASSWORD=change-me-development-only
POSTGRES_DB=hanbova
POSTGRES_PORT=5432

# API Security and Provider Selection
# In pilot/production: JWT_SECRET must be >=32 bytes and cannot be default/dev values.
JWT_SECRET=replace-with-a-local-development-secret-at-least-32-bytes
# In pilot/production: MINT_URL must use https:// and cannot point to localhost/private IP
MINT_URL=http://127.0.0.1:3338
MINT_PRIVATE_KEY=replace-with-a-local-development-mint-key

# Provider Mode: mock | sandbox | production
# In pilot: MUST be sandbox (mock is forbidden and fails closed at boot)
PROVIDER_MODE=mock

# CORS Allowed Origins: comma-separated list of origins
# In pilot/production: Wildcard '*' is forbidden and all origins must use https://
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Feature Flags
# In pilot/production: Default is false. Lightning service fails closed when disabled.
LIGHTNING_ENABLED=false

# Logging Configuration
RUST_LOG=info,hanbova_api=debug,tower_http=debug

# Mobile App API Base URL
MOBILE_API_BASE_URL=http://127.0.0.1:8080/api/v1

# External Provider Configurations (M3B.1 Spend + Travel)
# Bitnob (Payouts & Cards)
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=
BITNOB_API_KEY=
BITNOB_ENVIRONMENT=sandbox

# DT One (Digital Services, Bills & eSIM)
DTONE_API_KEY=
DTONE_API_SECRET=
DTONE_ENVIRONMENT=sandbox

